# Primavera Unifier Configuration
UNIFIER_BEARER_TOKEN=your_unifier_bearer_token_here
UNIFIER_BASE_URL=https://us2.unifier.oraclecloud.com/consulting/test/ws/rest/service/v1

# AI Chatbot API Key (Gemini only)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite
LLM_PROVIDER=gemini

# Background sync scheduler
# How often (minutes) to run a full cache sync. 0 disables the recurring loop
# (a one-off sync still runs at startup). Default: 60.
SYNC_INTERVAL_MIN=60
# Max projects to sweep for project-level records per sync run. The project catalog
# can be very large (tens of thousands of shells), so each run is bounded and the
# projects with the fewest cached records are synced first, so successive runs
# progressively cover the whole catalog. Set 0 to sweep everything in one run
# (only for small catalogs). Default: 250.
SYNC_MAX_PROJECTS=250

